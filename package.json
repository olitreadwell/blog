{
  "name": "blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Personal blog with an MCP-native content pipeline. Astro site, markdown content, static output.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:mcp": "node scripts/build-mcp.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-dist.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "e2e": "playwright test",
    "serve": "node scripts/serve-dist.mjs",
    "a11y": "playwright test e2e/accessibility.spec.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run build:mcp && npm run test && npm run smoke && npm run smoke:mcp",
    "check:full": "npm run check && npm run e2e"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@modelcontextprotocol/sdk": "1.31.0",
    "astro": "7.3.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
